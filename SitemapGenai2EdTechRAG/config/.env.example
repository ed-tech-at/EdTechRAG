# Template for one instance: copy this to config/<name>/.env, where <name> is
# the path segment of that site's trigger URL:
#
#   config/flaait/.env  ->  https://<host>/sitemapgenai2edtechrag/flaait/trigger
#
# One folder per site, one shared service (docker-compose.yml) and one Traefik
# router for all of them. Adding a site is this file plus its mirror checkout
# in out/ - no docker-compose change, no restart: the trigger server reads the
# folder on each request.
#
# The syntax is the KEY=VALUE subset of shell: comments, blank lines, and
# values that may be single- or double-quoted. Same file the tool itself reads
# on the host, so a working local .env can be moved in here unchanged.

# Which sites to mirror. One JSON array, because the three values of a site belong
# together: a sitemap URL without its repository_path is useless, and three
# parallel variables would drift apart.
#
#   key              directory in the mirror repository AND the path prefix of
#                    every path announced to EdTechRAG. A single path segment.
#   sitemap          absolute URL of sitemap-genai.xml. On the server this must
#                    be the PRODUCTION URL - a container cannot reach a laptop's
#                    dev server.
#   repository_path  updateConfig.repository_path of the EdTechRAG repository row.
#                    Must match EXACTLY - otherwise the API answers 404
#                    "Repository not found". ONE ROW PER SITE, so a search stays
#                    inside one website instead of mixing several.
#
# Single quotes are not decoration: the inner double quotes of the JSON only
# survive inside them.
SITEMAP_GENAI_SITES='[{"key":"example-website","sitemap":"https://example.tugraz.at/sitemap-genai/sitemap-genai.xml","repository_path":"llt/example-website-md"}]'

# Base of the ingest API, WITHOUT /pull, /chunk or /embed.
SitemapGenai2EdTechRAG_ENDPOINT=https://edtechrag.example.app/edtechrag/api/gitlab

# Shared secret of the repository rows. This is the authentication, not optional
# hardening: in src/lib/server/gitlabApi.ts the HMAC check reads
# `if (signatureSecret && ...)`, so a row WITHOUT a stored secret accepts any
# request that carries some X-Signature header. -mode=notify refuses to run
# without it.
SitemapGenai2EdTechRAG_SHARED_SECRET=change-me

# The mirror checkout of THIS instance, as a folder name below WORK_ROOT
# (./out, mounted as /work). Defaults to the instance folder's name, so this
# line is only needed when the checkout is called something else - which is the
# case for the existing out/<key>-website-md clones.
# MIRROR_DIR=example-website-md

# Required by the trigger server. Generate your own, a different value per
# instance: openssl rand -hex 32
# The website's own CI job sends it as "Authorization: Bearer <value>" to
# https://<host>/<SUBFOLDER>/<name>/trigger to start a sync after it deploys.
# An instance without it is not served at all (the trigger answers 404).
TRIGGER_SECRET=change-me

# Optional, per instance - otherwise the service-wide values from
# docker-compose.yml apply.
# MIRROR_BRANCH=main
# GIT_AUTHOR_NAME=GenAI Sync
# GIT_AUTHOR_EMAIL=noreply@tugraz.at

# Optional, set by the push stage: the commit that contains the new content.
# Without it -mode=notify falls back to the local HEAD.
# GENAI_HEAD_SHA=

# WORKDIR is ignored here unless it is an absolute container path: the value a
# host dry run needs (./out/<key>-website-md) is not the one the container
# needs. Use MIRROR_DIR above.
