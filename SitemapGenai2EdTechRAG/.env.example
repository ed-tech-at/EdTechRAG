# Which sites to mirror. One JSON array, because the three values of a site belong
# together: a sitemap URL without its repository_path is useless, and three
# parallel variables would drift apart.
#
#   key              directory in the mirror repository AND the path prefix of
#                    every path announced to EdTechRAG. A single path segment.
#   sitemap          absolute URL of sitemap-genai.xml
#   repository_path  updateConfig.repository_path of the EdTechRAG repository row.
#                    Must match EXACTLY - otherwise the API answers 404
#                    "Repository not found". ONE ROW PER SITE, so a search stays
#                    inside one website instead of mixing both.
#
# In single quotes: CI reads this file as variable definitions, but a local run
# reads it with `. ./.env` - and a shell strips the double quotes of an unquoted
# assignment. The tool would then see [{key:telucation,...}] and reject it.
SITEMAP_GENAI_SITES='[{"key":"telucation","sitemap":"https://telucation.tugraz.at/sitemap-genai/sitemap-genai.xml","repository_path":"llt/telucation-genai"},{"key":"flaait","sitemap":"https://flaait.tugraz.at/sitemap-genai/sitemap-genai.xml","repository_path":"llt/flaait-genai"}]'

# Base of the ingest API, WITHOUT /pull, /chunk or /embed.
SitemapGenai2EdTechRAG_ENDPOINT=https://e-flaait.tugraz.at/edtechrag/api/gitlab

# Shared secret of the repository rows. This is the authentication, not optional
# hardening: in src/lib/server/gitlabApi.ts the HMAC check reads
# `if (signatureSecret && ...)`, so a row WITHOUT a stored secret accepts any
# request that carries some X-Signature header. -mode=notify refuses to run
# without it.
SitemapGenai2EdTechRAG_SHARED_SECRET=change-me

# The git checkout of the mirror repository. In CI this is $CI_PROJECT_DIR.
WORKDIR=./out

# Optional, set by the push stage: the commit that contains the new content.
# Without it -mode=notify falls back to the local HEAD.
# GENAI_HEAD_SHA=

# Only used by the Docker trigger server (SitemapGenai2EdTechRAG/trigger), not
# by the tool itself. Required - the server refuses to start without it.
# Generate with: openssl rand -hex 32
# The website's own CI job sends this as "Authorization: Bearer <value>" to
# https://<host>/<SUBFOLDER>/trigger to start a sync after it deploys.
TRIGGER_SECRET=change-me
