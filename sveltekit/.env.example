DATABASE_URL="postgresql://edtechrag_dev:PASSWORT_NOGIT@pgvector-edtechrag:5432/edtechrag_dev"
SHADOW_DATABASE_URL="postgresql://edtechrag_dev:PASSWORT_NOGIT@pgvector-edtechrag:5432/edtechrag_migrations"

SESSION_JWT_SECRET = JWT_NOGIT

SERVER_PW_PEPPER = PEPPER_NOTGIT

# Instance-wide page footer: complete HTML including the <footer> element itself
# (set colours etc. inline). Unset means an empty <footer></footer>. Repositories can
# override it for their webview page in the admin config (Webview > Footer).
PUBLIC_FOOTER_HTML="<footer style='background:#263b48;color:white;padding:20px'><a href='https://edtechrag.local/impressum' target='_blank' style='color:white'>Impressum</a></footer>"

# adapter-node request body limit (default 512K). The embedding import on /admin/embeddings
# posts batches of a few MB; without this it still works, just in many small requests.
BODY_SIZE_LIMIT=16M
